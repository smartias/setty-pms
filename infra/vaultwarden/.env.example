# Copy this file to .env in the same folder and fill in real values.
# NEVER commit the real .env file — it holds the admin secret. This folder's
# .gitignore already excludes it, but double-check `git status` before any
# commit from this directory.

# Full HTTPS URL Vaultwarden should think it's served at.
DOMAIN=https://vault.yourdomain.com

# Same host, no scheme — this is what Caddy uses for the site block.
CADDY_HOST=vault.yourdomain.com

# Long random string protecting the /admin panel (used to invite users and
# manage the org). Generate one with: openssl rand -base64 48
ADMIN_TOKEN=change-me-to-a-long-random-value

# Keep false once the NY team is invited — this is what makes the instance
# invite-only instead of open signup.
SIGNUPS_ALLOWED=false
